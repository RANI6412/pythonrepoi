pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/USERNAME/PythonCICD.git'
            }
        }

        stage('Compilation') {
            steps {
                bat 'py -m py_compile app.py'
            }
        }

        stage('Testing') {
            steps {
                bat 'py test.py'
            }
        }

        stage('Packaging') {
            steps {
                bat 'tar -a -c -f PythonCICD.zip app.py'
            }
        }
    }
}
